{
  "schemaVersion": 1,
  "id": "bzassist",
  "version": "${version}",
  "name": "Bazaar Assist",
  "description": "Shows you which bazaar slot to click and which command to type. It never clicks, types or moves for you.",
  "authors": ["FlipperX"],
  "license": "ARR",
  "environment": "client",
  "entrypoints": {
    "client": ["com.flipperx.assist.AssistClient"]
  },
  "mixins": ["bzassist.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
